      "updated": 1784917539570,
      "link": null,
      "locked": false,
      "text": "Responsible for handling:\n- Posts (a short text + track reference + optional image)\n- Comments for posts (and the track) with replies\n- Follower / Followee relations",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Responsible for handling:\n- Posts (a short text + track reference + optional image)\n- Comments for posts (and the track) with replies\n- Follower / Followee relations",
